"use client";
// ═══════════════════════════════════════════════════════════════════════════════
// Command Palette — ⌘K navigation + actions
// ═══════════════════════════════════════════════════════════════════════════════

import * as React from "react";
import { Command } from "cmdk"; import { Search, X } from "lucide-react";
import { useRouter } from "next/navigation";
import { cn } from "./utils";

export interface CommandItem {
  id: string;
  label: string;
  hint?: string;
  group?: string;
  icon?: React.ComponentType<{ className?: string; size?: number }>;
  onSelect: () => void;
  keywords?: string[];
}

interface CommandPaletteProps {
  items: CommandItem[];
  open: boolean;
  onOpenChange: (open: boolean) => void;
  placeholder?: string;
  emptyMessage?: string;
}

export function CommandPalette({
  items,
  open,
  onOpenChange,
  placeholder = "Search or type a command…",
  emptyMessage = "No results found.",
}: CommandPaletteProps) {
  const router = useRouter();

  // Global ⌘K / Ctrl+K listener
  React.useEffect(() => {
    const handleKey = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        onOpenChange(!open);
      }
      if (e.key === "Escape" && open) {
        onOpenChange(false);
      }
    };
    window.addEventListener("keydown", handleKey);
    return () => window.removeEventListener("keydown", handleKey);
  }, [open, onOpenChange]);

  // Group items
  const grouped = React.useMemo(() => {
    const map = new Map<string, CommandItem[]>();
    for (const item of items) {
      const g = item.group ?? "Navigation";
      const list = map.get(g) ?? [];
      list.push(item);
      map.set(g, list);
    }
    return Array.from(map.entries());
  }, [items]);

  const handleSelect = (item: CommandItem) => {
    onOpenChange(false);
    item.onSelect();
    router.refresh();
  };

  return (
    <Command.Dialog
      open={open}
      onOpenChange={onOpenChange}
      label="Command palette"
      className={cn(
        "fixed left-1/2 top-[15%] z-[100] -translate-x-1/2",
        "w-[calc(100%-2rem)] max-w-xl",
        "rounded-2xl overflow-hidden",
        "bg-[var(--color-surface)] border border-[var(--color-border)]",
        "shadow-2xl",
        "animate-in fade-in-0 zoom-in-95 slide-in-from-top-4",
      )}
    >
      <div className="flex items-center gap-3 px-4 border-b border-[var(--color-border)]">
        <Search size={15} className="text-[var(--color-subtle-foreground)] shrink-0" />
        <Command.Input
          placeholder={placeholder}
          autoFocus
          className={cn(
            "flex-1 h-14 bg-transparent border-0 outline-none",
            "text-sm text-[var(--color-foreground)]",
            "placeholder:text-[var(--color-subtle-foreground)]",
          )}
        />
        <button
          onClick={() => onOpenChange(false)}
          className="p-1 rounded-md hover:bg-[var(--color-surface-raised)] text-[var(--color-muted-foreground)]"
          aria-label="Close"
        >
          <X size={14} />
        </button>
      </div>

      <Command.List className="max-h-96 overflow-y-auto p-2">
        <Command.Empty className="py-8 text-center text-sm text-[var(--color-muted-foreground)]">
          {emptyMessage}
        </Command.Empty>

        {grouped.map(([group, groupItems]) => (
          <Command.Group
            key={group}
            heading={group}
            className={cn(
              "[&_[cmdk-group-heading]]:px-2 [&_[cmdk-group-heading]]:py-2",
              "[&_[cmdk-group-heading]]:text-[10px] [&_[cmdk-group-heading]]:font-black",
              "[&_[cmdk-group-heading]]:uppercase [&_[cmdk-group-heading]]:tracking-widest",
              "[&_[cmdk-group-heading]]:text-[var(--color-muted-foreground)]",
            )}
          >
            {groupItems.map((item) => {
              const Icon = item.icon;
              return (
                <Command.Item
                  key={item.id}
                  value={`${item.label} ${(item.keywords ?? []).join(" ")}`}
                  onSelect={() => handleSelect(item)}
                  className={cn(
                    "flex items-center gap-3 px-3 py-2.5 rounded-lg cursor-pointer",
                    "text-sm text-[var(--color-foreground)]",
                    "aria-selected:bg-[var(--color-surface-raised)]",
                    "transition-colors duration-100",
                  )}
                >
                  {Icon && <Icon size={15} className="text-[var(--color-muted-foreground)] shrink-0" />}
                  <span className="flex-1 truncate">{item.label}</span>
                  {item.hint && (
                    <span className="text-[10px] font-mono text-[var(--color-subtle-foreground)] shrink-0">
                      {item.hint}
                    </span>
                  )}
                </Command.Item>
              );
            })}
          </Command.Group>
        ))}
      </Command.List>

      <div className="px-4 py-2.5 border-t border-[var(--color-border)] bg-[var(--color-surface-raised)]">
        <div className="flex items-center justify-between text-[10px] text-[var(--color-muted-foreground)] font-mono">
          <span>↑↓ navigate · ↵ select · esc close</span>
          <span>⌘K to toggle</span>
        </div>
      </div>
    </Command.Dialog>
  );
}
