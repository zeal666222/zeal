"use client";
// ZEAL_FIX_FE_WHITELABEL_PAGE
// Dedicated white-label configuration page — resolves the "dead nav" issue.
import { Check, Copy, ExternalLink, Loader2, Save, useEffect,
  useState } from "react"; import { motion } from "framer-motion"; import { Palette } from "lucide-react";

interface Theme {
  primaryColor: string;
  accentColor: string;
  welcomeMessage: string;
  logoUrl?: string;
}

const DEFAULTS: Theme = {
  primaryColor: "#9D7DC5",
  accentColor: "#533AFD",
  welcomeMessage: "Welcome to my practice",
  logoUrl: "",
};

export default function WhiteLabelPage() {
  const [theme, setTheme] = useState<Theme>(DEFAULTS);
  const [subdomain, setSubdomain] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [saved, setSaved] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);

  useEffect(() => {
    (async () => {
      try {
        const res = await fetch("/api/consultant/pulse", { cache: "no-store" });
        if (res.ok) {
          const data = await res.json();
          const t = data?.consultant?.theme as Partial<Theme> | undefined;
          if (t) setTheme({ ...DEFAULTS, ...t });
          setSubdomain(data?.consultant?.subdomain ?? null);
        }
      } finally { setLoading(false); }
    })();
  }, []);

  const save = async () => {
    setSaving(true); setError(null); setSaved(false);
    try {
      const res = await fetch("/api/consultant/profile", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ theme }),
      });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        throw new Error((body as { error?: string }).error || "Save failed");
      }
      setSaved(true);
      setTimeout(() => setSaved(false), 2000);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Save failed");
    } finally { setSaving(false); }
  };

  const copyUrl = async () => {
    if (!subdomain) return;
    try {
      await navigator.clipboard.writeText(`https://${subdomain}.zeal.app`);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch { /* ignore */ }
  };

  if (loading) return <div className="flex justify-center py-20"><Loader2 className="w-8 h-8 animate-spin text-purple-500" /></div>;

  return (
    <motion.div initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} className="space-y-6 max-w-3xl">
      <div>
        <h1 className="text-2xl lg:text-3xl font-black text-white flex items-center gap-2">
          <Palette className="w-6 h-6 text-purple-400" /> White-Label Studio
        </h1>
        <p className="text-sm text-slate-400 mt-1">
          Brand your public site — colors, welcome message, and logo.
        </p>
      </div>

      {subdomain && (
        <div className="p-4 rounded-2xl bg-purple-500/10 border border-purple-500/20">
          <p className="text-[10px] uppercase tracking-widest text-purple-300 font-bold mb-1">Your URL</p>
          <div className="flex items-center gap-2">
            <p className="text-sm font-mono text-white flex-1 truncate">{subdomain}.zeal.app</p>
            <button onClick={copyUrl} className="p-2 rounded-lg hover:bg-white/10 text-purple-300" aria-label="Copy URL">
              {copied ? <Check size={14} /> : <Copy size={14} />}
            </button>
            <a href={`/white-label/${subdomain}`} target="_blank" rel="noopener noreferrer"
              className="p-2 rounded-lg hover:bg-white/10 text-purple-300" aria-label="Open site">
              <ExternalLink size={14} />
            </a>
          </div>
        </div>
      )}

      <div className="rounded-3xl border border-white/5 bg-slate-900/40 p-6 space-y-5">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label className="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Primary color</label>
            <input type="color" value={theme.primaryColor}
              onChange={(e) => setTheme({ ...theme, primaryColor: e.target.value })}
              className="w-full h-12 bg-slate-950 border border-white/10 rounded-xl cursor-pointer" />
          </div>
          <div>
            <label className="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Accent color</label>
            <input type="color" value={theme.accentColor}
              onChange={(e) => setTheme({ ...theme, accentColor: e.target.value })}
              className="w-full h-12 bg-slate-950 border border-white/10 rounded-xl cursor-pointer" />
          </div>
        </div>

        <div>
          <label className="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Welcome message</label>
          <input type="text" value={theme.welcomeMessage} maxLength={120}
            onChange={(e) => setTheme({ ...theme, welcomeMessage: e.target.value })}
            className="w-full px-4 py-3 bg-slate-950 border border-white/10 rounded-xl text-sm text-white outline-none focus:border-purple-500" />
        </div>

        <div>
          <label className="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Logo URL (optional)</label>
          <input type="url" value={theme.logoUrl ?? ""} placeholder="https://..."
            onChange={(e) => setTheme({ ...theme, logoUrl: e.target.value })}
            className="w-full px-4 py-3 bg-slate-950 border border-white/10 rounded-xl text-sm text-white outline-none focus:border-purple-500" />
        </div>

        {error && (
          <div className="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-bold">{error}</div>
        )}

        <button onClick={save} disabled={saving}
          className="w-full py-3.5 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-black text-sm disabled:opacity-50 flex items-center justify-center gap-2">
          {saving ? <><Loader2 size={15} className="animate-spin" /> Saving…</>
           : saved ? <><Check size={15} /> Saved</>
           : <><Save size={15} /> Save changes</>}
        </button>
      </div>
    </motion.div>
  );
}
