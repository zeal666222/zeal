"use client";
// ZEAL_FIX_FE_SERVICE_PICKER
// Multi-select service picker with category grouping + proficiency.
import { AlertCircle, AnimatePresence } from "framer-motion"; import { Search, Check,
  ChevronDown, ChevronRight, Loader2, Sparkles, useCallback, useEffect, useMemo,
  useState } from "react"; import { motion } from "lucide-react";

interface CatalogService {
  id: string;
  name: string;
  slug: string;
  parent_category: string;
}
interface CatalogGroup {
  categoryId: string;
  categoryName: string;
  sortOrder: number;
  services: CatalogService[];
}
interface SelectedService {
  serviceId: string;
  proficiency: number;
}

interface Props {
  initialSelected?: SelectedService[];
  onSave?: (services: SelectedService[]) => Promise<void>;
  readOnly?: boolean;
}

export function ServicePicker({ initialSelected = [], onSave, readOnly = false }: Props) {
  const [groups, setGroups] = useState<CatalogGroup[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState(false);
  const [search, setSearch] = useState("");
  const [expanded, setExpanded] = useState<Set<string>>(new Set());
  const [selected, setSelected] = useState<Map<string, number>>(
    new Map(initialSelected.map((s) => [s.serviceId, s.proficiency])),
  );

  const loadCatalog = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch("/api/consultants/service-catalog", { cache: "no-store" });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = (await res.json()) as { groups?: CatalogGroup[] };
      setGroups(data.groups ?? []);
      // Auto-expand the first 3 categories that have services
      const firstThree = (data.groups ?? []).filter((g) => g.services.length > 0).slice(0, 3);
      setExpanded(new Set(firstThree.map((g) => g.categoryId)));
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void loadCatalog(); }, [loadCatalog]);

  const filteredGroups = useMemo(() => {
    if (!search.trim()) return groups;
    const q = search.toLowerCase();
    return groups
      .map((g) => ({
        ...g,
        services: g.services.filter(
          (s) => s.name.toLowerCase().includes(q) || s.slug.includes(q),
        ),
      }))
      .filter((g) => g.services.length > 0);
  }, [groups, search]);

  const toggleService = useCallback((serviceId: string) => {
    if (readOnly) return;
    setSelected((prev) => {
      const next = new Map(prev);
      if (next.has(serviceId)) next.delete(serviceId);
      else next.set(serviceId, 3);
      return next;
    });
  }, [readOnly]);

  const setProficiency = useCallback((serviceId: string, level: number) => {
    setSelected((prev) => {
      const next = new Map(prev);
      if (next.has(serviceId)) next.set(serviceId, Math.max(1, Math.min(5, level)));
      return next;
    });
  }, []);

  const toggleCategory = useCallback((categoryId: string) => {
    setExpanded((prev) => {
      const next = new Set(prev);
      if (next.has(categoryId)) next.delete(categoryId);
      else next.add(categoryId);
      return next;
    });
  }, []);

  const handleSave = async () => {
    if (!onSave || readOnly) return;
    setSaving(true);
    setError(null);
    setSuccess(false);
    try {
      await onSave(
        Array.from(selected.entries()).map(([serviceId, proficiency]) => ({
          serviceId,
          proficiency,
        })),
      );
      setSuccess(true);
      setTimeout(() => setSuccess(false), 2500);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Save failed");
    } finally {
      setSaving(false);
    }
  };

  if (loading) {
    return (
      <div className="flex justify-center py-16">
        <Loader2 className="w-6 h-6 animate-spin text-purple-500" />
      </div>
    );
  }

  return (
    <div className="space-y-4">
      {/* Search + selection counter */}
      <div className="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
        <div className="relative flex-1">
          <Search size={15} className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500" />
          <input
            type="text"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Search services..."
            aria-label="Search services"
            className="w-full pl-10 pr-4 py-2.5 bg-slate-900/60 border border-white/10 rounded-xl text-sm text-white placeholder:text-slate-500 outline-none focus:border-purple-500/50"
          />
        </div>
        <div className="px-4 py-2.5 rounded-xl bg-purple-500/10 border border-purple-500/20 text-sm text-purple-300 font-bold text-center">
          {selected.size} selected
        </div>
      </div>

      {/* Error */}
      {error && (
        <div className="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-bold flex items-center gap-2">
          <AlertCircle size={14} /> {error}
        </div>
      )}

      {/* Success */}
      <AnimatePresence>
        {success && (
          <motion.div
            initial={{ opacity: 0, y: -8 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0 }}
            className="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold flex items-center gap-2"
          >
            <Check size={14} /> Services saved
          </motion.div>
        )}
      </AnimatePresence>

      {/* Category groups */}
      <div className="space-y-2 max-h-[60vh] overflow-y-auto pr-1 custom-scrollbar">
        {filteredGroups.map((group) => {
          const isExpanded = expanded.has(group.categoryId) || search.length > 0;
          const selectedInGroup = group.services.filter((s) => selected.has(s.id)).length;
          return (
            <div
              key={group.categoryId}
              className="rounded-2xl border border-white/5 bg-slate-900/40 overflow-hidden"
            >
              <button
                type="button"
                onClick={() => toggleCategory(group.categoryId)}
                className="w-full flex items-center gap-3 px-4 py-3 hover:bg-white/[0.03] transition-colors text-left"
              >
                <div className="p-1.5 rounded-lg bg-purple-500/10">
                  {isExpanded ? (
                    <ChevronDown size={14} className="text-purple-400" />
                  ) : (
                    <ChevronRight size={14} className="text-purple-400" />
                  )}
                </div>
                <span className="flex-1 font-bold text-sm text-white">
                  {group.categoryName}
                </span>
                {selectedInGroup > 0 && (
                  <span className="text-[10px] font-black px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300">
                    {selectedInGroup} selected
                  </span>
                )}
                <span className="text-xs text-slate-500">{group.services.length}</span>
              </button>

              <AnimatePresence initial={false}>
                {isExpanded && (
                  <motion.div
                    initial={{ height: 0, opacity: 0 }}
                    animate={{ height: "auto", opacity: 1 }}
                    exit={{ height: 0, opacity: 0 }}
                    transition={{ duration: 0.2 }}
                    className="overflow-hidden"
                  >
                    <div className="px-3 pb-3 pt-1 grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {group.services.map((service) => {
                        const isSelected = selected.has(service.id);
                        const proficiency = selected.get(service.id) ?? 3;
                        return (
                          <div
                            key={service.id}
                            className={`rounded-xl border transition-all ${
                              isSelected
                                ? "bg-purple-500/10 border-purple-500/40"
                                : "bg-slate-950/50 border-white/5 hover:border-purple-500/20"
                            }`}
                          >
                            <button
                              type="button"
                              onClick={() => toggleService(service.id)}
                              disabled={readOnly}
                              className="w-full flex items-center gap-2.5 px-3 py-2.5 text-left disabled:cursor-not-allowed"
                            >
                              <span
                                className={`w-4 h-4 rounded flex items-center justify-center border-2 transition-all shrink-0 ${
                                  isSelected
                                    ? "bg-purple-500 border-purple-500"
                                    : "border-white/20 bg-transparent"
                                }`}
                              >
                                {isSelected && <Check size={10} className="text-white" />}
                              </span>
                              <span className="flex-1 text-sm text-white truncate">
                                {service.name}
                              </span>
                            </button>

                            {isSelected && !readOnly && (
                              <div className="px-3 pb-2 flex items-center gap-1">
                                {[1, 2, 3, 4, 5].map((n) => (
                                  <button
                                    key={n}
                                    type="button"
                                    onClick={() => setProficiency(service.id, n)}
                                    aria-label={`Proficiency ${n} of 5`}
                                    className={`w-5 h-5 rounded text-[10px] font-black transition-all ${
                                      n <= proficiency
                                        ? "bg-amber-500/30 text-amber-300"
                                        : "bg-white/5 text-slate-600 hover:bg-white/10"
                                    }`}
                                  >
                                    ★
                                  </button>
                                ))}
                              </div>
                            )}
                          </div>
                        );
                      })}
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>
            </div>
          );
        })}
      </div>

      {/* Save button */}
      {!readOnly && onSave && (
        <button
          type="button"
          onClick={handleSave}
          disabled={saving}
          className="w-full py-4 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white text-sm font-black hover:opacity-90 disabled:opacity-50 flex items-center justify-center gap-2"
        >
          {saving ? (
            <><Loader2 size={16} className="animate-spin" /> Saving...</>
          ) : (
            <><Sparkles size={16} /> Save Services ({selected.size})</>
          )}
        </button>
      )}
    </div>
  );
}
