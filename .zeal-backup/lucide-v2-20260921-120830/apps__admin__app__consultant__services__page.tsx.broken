"use client";
// ZEAL_FIX_FE_SERVICES_PAGE
// Consultant-facing service management.
import { AlertCircle, Loader2, useCallback, useEffect,
  useState } from "react"; import { motion } from "framer-motion"; import { Sparkles } from "lucide-react";
import { ServicePicker } from "@/components/consultant/ServicePicker";

interface SelectedService { serviceId: string; proficiency: number; }

export default function ConsultantServicesPage() {
  const [initial, setInitial] = useState<SelectedService[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const loadCurrent = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch("/api/consultant/services", { cache: "no-store" });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = (await res.json()) as { services?: Array<{ service_id: string; proficiency: number }> };
      setInitial((data.services ?? []).map((s) => ({
        serviceId: s.service_id,
        proficiency: s.proficiency,
      })));
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void loadCurrent(); }, [loadCurrent]);

  const handleSave = useCallback(async (services: SelectedService[]) => {
    const res = await fetch("/api/consultant/services", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ services }),
    });
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      throw new Error((body as { error?: string }).error || `HTTP ${res.status}`);
    }
  }, []);

  if (loading) {
    return (
      <div className="flex justify-center py-20">
        <Loader2 className="w-8 h-8 animate-spin text-purple-500" />
      </div>
    );
  }

  return (
    <motion.div
      initial={{ opacity: 0, y: 8 }}
      animate={{ opacity: 1, y: 0 }}
      className="space-y-6 max-w-3xl"
    >
      <div>
        <h1 className="text-2xl lg:text-3xl font-black text-white flex items-center gap-2">
          <Sparkles className="w-6 h-6 text-purple-400" /> My Services
        </h1>
        <p className="text-sm text-slate-400 mt-1">
          Tag the specific services you offer. Seekers filter by these — more services means more visibility.
        </p>
      </div>

      {error && (
        <div className="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-bold flex items-center gap-2">
          <AlertCircle size={14} /> {error}
        </div>
      )}

      <div className="rounded-3xl border border-white/5 bg-slate-900/40 p-5">
        <ServicePicker initialSelected={initial} onSave={handleSave} />
      </div>
    </motion.div>
  );
}
