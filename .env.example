# ═══════════════════════════════════════════════════════════════════════════════
# ZEAL — ENVIRONMENT VARIABLES TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to apps/web/.env.local and apps/admin/.env.local
# Never commit actual keys. Rotate immediately if leaked.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Supabase (REQUIRED) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # ⚠️ server-only, never NEXT_PUBLIC_

# ─── AI providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...                     # console.groq.com (free tier)
AGNES_API_KEY=sk-...                     # platform.agnes-ai.com (optional)
ASTROASK_API_KEY=...                     # rapidapi.com/astroask (optional, 500 req/mo free)

# ─── Redis / rate limit ──────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── Payments ────────────────────────────────────────────────────────────────
INSTAMOJO_API_KEY=...
INSTAMOJO_AUTH_TOKEN=...
INSTAMOJO_SALT=...                       # webhook HMAC secret

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_REALTIME_ENABLED=true
CRON_SECRET=any-random-string

# ─── Astrology Worker (Cloudflare Worker) ────────────────────────────────────
# Local dev:  http://localhost:8787  (run: cd apps/astro-worker && npx wrangler dev)
# Prod:       https://zeal-astro.<your-subdomain>.workers.dev
ASTRO_WORKER_URL=http://localhost:8787

# ─── Storage (Cloudflare R2 — optional) ──────────────────────────────────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=zeal
R2_PUBLIC_URL=https://...

# Optional Cloudflare image optimization (both default OFF → raw R2 URLs).
# Strategy 1: Image Resizing on the R2 public Cloudflare zone (/cdn-cgi/image/).
#   Set to 1 only if R2_PUBLIC_URL is a Cloudflare zone with Image Resizing on.
NEXT_PUBLIC_CF_IMAGE_RESIZE=
# Strategy 2: Cloudflare Images delivery (imagedelivery.net) — your account hash.
#   Requires named variants: avatarSm, avatarMd, grid, detail, detail2x.
NEXT_PUBLIC_CF_IMAGES_ACCOUNT_HASH=

# ─── Email (Resend — optional) ───────────────────────────────────────────────
RESEND_API_KEY=re_...
# ─── Razorpay (Phase 1) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ─── Database Connection Pool ─────────────────────────────────────────────────
DB_POOL_SIZE=20                          # max connections in pool
DB_POOL_TIMEOUT=30000                    # query timeout in ms
DB_POOL_MAX_RETRIES=3                    # retry attempts for transient failures

# ─── Monitoring / Load Testing ────────────────────────────────────────────────
LOAD_TEST_BASE_URL=http://localhost:3000 # target URL for load tests
LOAD_TEST_AUTH_TOKEN=...                 # test user JWT for authenticated endpoints

# ─── AI Chat Concurrency ─────────────────────────────────────────────────────
AI_CHAT_PER_USER_MAX=5                   # max concurrent AI chats per user
AI_CHAT_GLOBAL_MAX=100                   # max concurrent AI chats platform-wide
